# DevEcho Development Environment Configuration
# Usage: cp .env.dev.example .env.dev && source .env.dev

# AWS Profile (set up with: aws configure sso --profile devecho)
export AWS_PROFILE="devecho"
export AWS_REGION="us-west-2"
export DEVECHO_S3_BUCKET="your-s3-bucket-name"
export DEVECHO_S3_PREFIX="kb-documents/"
export DEVECHO_KB_ID="your-knowledge-base-id"
export DEVECHO_KB_DS_ID="your-data-source-id"
export DEVECHO_BEDROCK_MODEL="us.anthropic.claude-sonnet-4-5-20250929-v1:0"
